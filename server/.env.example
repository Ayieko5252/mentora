# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
# Matches docker-compose.yml. Change if you use your own Postgres.
DATABASE_URL="postgresql://mentora:mentora@localhost:5432/mentora?schema=public"

# ---- Auth ----
# Use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Stripe (test / sandbox mode) ----
# Get test keys from https://dashboard.stripe.com/test/apikeys
# If STRIPE_SECRET_KEY is left blank, the app runs in MOCK payment mode:
# checkout is auto-completed locally so you can demo purchases without Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
